# Public site and headless WordPress API
NEXT_PUBLIC_SITE_URL=https://dailysamachar.org
NEXT_PUBLIC_WORDPRESS_API_URL=https://api.dailysamachar.org
# Optional Google Search Console HTML-tag verification token for the production property.
# Use the token issued for https://dailysamachar.org (not a www, HTTP, preview, or staging property).
GOOGLE_SITE_VERIFICATION=
# Server-only WordPress site origin. Keep one value only; use a local origin only while its CMS is running.
WORDPRESS_API_URL=https://api.dailysamachar.org

# Do not set NODE_TLS_REJECT_UNAUTHORIZED=0. Fix an invalid CMS TLS certificate instead.

# Hostinger -> Vercel webhook authentication
# Preferred webhook secret. REVALIDATION_SECRET remains supported for compatibility.
REVALIDATION_SECRET_TOKEN=replace-with-a-long-random-secret
REVALIDATION_SECRET=replace-with-a-long-random-secret
DRAFT_SECRET_TOKEN=replace-with-a-long-random-secret
# Required before enabling login/signup/reset. Point this at the approved auth service.
AUTH_PROVIDER_URL=

# AdSense: use the exact values copied from AdSense. Do not leave placeholders in production.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-4608193844622252
NEXT_PUBLIC_ADSENSE_SLOT_TOP=replace-with-top-ad-unit-id
NEXT_PUBLIC_ADSENSE_SLOT_INLINE=replace-with-inline-ad-unit-id
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=replace-with-sidebar-ad-unit-id
NEXT_PUBLIC_ADSENSE_SLOT_STICKY=replace-with-sticky-ad-unit-id
NEXT_PUBLIC_ADSENSE_SLOT_VIDEO=replace-with-video-ad-unit-id

# Optional market provider. The endpoint may return an array, { data: [] }, or { results: [] }.
MARKET_PROVIDER_URL=https://provider.example.com/markets

# Server-only MetalpriceAPI credentials. Never use NEXT_PUBLIC_ for this key.
METALPRICE_API_KEY=replace-with-metalpriceapi-key
METALPRICE_API_URL=https://api.metalpriceapi.com/v1/latest

# Optional custom weather provider endpoint (/weather?city=...)
WEATHER_PROVIDER_URL=

# Server-only Google Cloud Translation (enable Cloud Translation API in Google Cloud first)
GOOGLE_TRANSLATE_API_URL=https://translation.googleapis.com/language/translate/v2
GOOGLE_TRANSLATE_API_KEY=replace-with-google-translate-api-key
